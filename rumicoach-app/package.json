  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 3000 --clear",
    "web:build": "expo export --platform web",
    "web:serve": "bunx expo serve --port 3000",
    "test": "jest",
    "lint": "expo lint",
    "e2e:server": "cd e2e/mock-server && bun server.js",
    "e2e:server:dev": "cd e2e/mock-server && bun --watch server.js",
    "e2e:test:http": "cd e2e/mock-server && bash test-routes.sh",
    "e2e:test:ws": "cd e2e/mock-server && bun test-websocket.js",
    "e2e:test:all": "cd e2e/mock-server && bash test-routes.sh && bun test-websocket.js",
    "e2e:pipeline": "bash e2e/mock-server/run-pipeline.sh",
    "e2e:maestro:smoke": "maestro test --include-tag=smoke e2e/maestro/flows/",
    "e2e:maestro:auth": "maestro test --include-tag=auth e2e/maestro/flows/",
    "e2e:maestro:all": "maestro test e2e/maestro/flows/",
    "e2e:dev:ios": "cp .env.e2e .env && bun run e2e:server:dev & sleep 3 && expo start --ios",
    "e2e:dev:android": "cp .env.e2e .env && bun run e2e:server:dev & sleep 3 && expo start --android",
    "e2e:dev:web": "cp .env.e2e .env && bun run e2e:server:dev & sleep 3 && expo start --web"
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "patchedDependencies": {
    "@speechmatics/expo-two-way-audio@0.1.2": "patches/@speechmatics%2Fexpo-two-way-audio@0.1.2.patch"
  }
